<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    tools:context=".pantallaCalculadoras">

    <View
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/fondo_curvo"
        app:layout_constraintTop_toTopOf="parent"
        />
    <TextView
        android:id="@+id/textoUno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Casio Store    |"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/blanco"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="@id/vista"
        app:layout_constraintBottom_toBottomOf="@id/vista"
        app:layout_constraintStart_toStartOf="parent"

        />

    <TextView
        android:id="@+id/textoDos"
        android:layout_width="180dp"
        android:layout_height="32dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="@color/blanco"
        android:text="CALCULADORAS"
        android:textSize="24sp"
        android:textColor="@color/blanco"
        app:layout_constraintTop_toTopOf="@+id/vista"
        app:layout_constraintBottom_toBottomOf="@+id/vista"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!--espacio donde se proyectara los fragmentos-->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorprincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/vista"
        app:layout_constraintBottom_toTopOf="@id/layaoutUno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <!--barra de navegacion inferior-->
    <LinearLayout
        android:id="@+id/layaoutUno"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/blanco"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <!--apartado para los botones 3 layouts para los botones de inicio, carrito, usuario-->
        <LinearLayout
            android:id="@+id/botonInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/imagenUno"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/home"
                />
            <TextView
                android:id="@+id/Inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textStyle="bold"
                android:textColor="@color/negro"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/botonCarrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/imagenDOs"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/carrito"
                />
            <TextView
                android:id="@+id/Carrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carrito"
                android:textStyle="bold"
                android:textColor="@color/negro"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/botonUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/imagenTres"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/usuario"
                />
            <TextView
                android:id="@+id/Usuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textStyle="bold"
                android:textColor="@color/negro"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>