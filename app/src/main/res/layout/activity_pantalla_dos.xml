<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    tools:context=".pantallaDos">

    <View
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/fondo_curvo"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- Botón de retroceso general (Comienza oculto con visibility="gone") -->
    <ImageView
        android:id="@+id/btnAtrasGeneral"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        android:contentDescription="Volver"
        android:visibility="gone"
        app:tint="@color/blanco"
        app:layout_constraintTop_toTopOf="@id/vista"
        app:layout_constraintBottom_toBottomOf="@id/vista"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textoUno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Casio Store |"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/blanco"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/vista"
        app:layout_constraintBottom_toBottomOf="@id/vista"
        app:layout_constraintStart_toEndOf="@id/btnAtrasGeneral"
        />

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/campana"
        app:tint="@color/blanco"
        app:layout_constraintTop_toTopOf="@id/vista"
        app:layout_constraintBottom_toBottomOf="@id/vista"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--espacio donde se proyectara los fragmentos-->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorprincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/vista"
        app:layout_constraintBottom_toTopOf="@id/layaoutUno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--barra de navegacion inferior-->
    <LinearLayout
        android:id="@+id/layaoutUno"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/blanco"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/botonInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/home" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textStyle="bold"
                android:textColor="@color/negro"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/botonCarrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/carrito" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carrito"
                android:textStyle="bold"
                android:textColor="@color/negro"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/botonUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/usuario" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textStyle="bold"
                android:textColor="@color/negro"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>