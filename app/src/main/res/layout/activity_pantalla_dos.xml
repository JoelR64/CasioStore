<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    tools:context=".pantallaDos">

    <View
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/fondo_curvo"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botón de retroceso general -->
    <ImageView
        android:id="@+id/btnAtrasGeneral"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        android:contentDescription="@string/desc_volver"
        android:visibility="gone"
        app:tint="@color/blanco"
        app:layout_constraintTop_toTopOf="@id/vista"
        app:layout_constraintBottom_toBottomOf="@id/vista"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textoUno"
        style="@style/EstiloTextoHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_casio_store"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/vista"
        app:layout_constraintBottom_toBottomOf="@id/vista"
        app:layout_constraintStart_toEndOf="@id/btnAtrasGeneral" />

    <ImageView
        android:id="@+id/btnCampanaNotificaciones"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/campana"
        android:contentDescription="@string/desc_notificaciones"
        app:tint="@color/blanco"
        app:layout_constraintTop_toTopOf="@id/vista"
        app:layout_constraintBottom_toBottomOf="@id/vista"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Espacio donde se proyectarán los fragmentos -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorprincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/vista"
        app:layout_constraintBottom_toTopOf="@id/layaoutUno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de navegación inferior -->
    <LinearLayout
        android:id="@+id/layaoutUno"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/blanco"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/botonInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/home"
                android:contentDescription="@string/menu_inicio" />
            <TextView
                style="@style/EstiloTextoMenuInferior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_inicio" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/botonCarrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/carrito"
                android:contentDescription="@string/menu_carrito" />
            <TextView
                style="@style/EstiloTextoMenuInferior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_carrito" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/botonUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/usuario"
                android:contentDescription="@string/menu_usuario" />
            <TextView
                style="@style/EstiloTextoMenuInferior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_usuario" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>