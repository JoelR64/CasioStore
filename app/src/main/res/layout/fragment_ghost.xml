<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/usuario"
        android:contentDescription="@string/desc_avatar_usuario" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="PANTALLA GHOST / CRÉDITOS"
        style="@style/EstiloTextoHeader"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineSpacingExtra="8dp"
        android:text="Desarrollado por:\nVerusca Lorena Orellana Rodas \nJoel Roque Antinapa"
        android:textColor="@color/blanco"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Universidad Privada Domingo Savio\nIngeniería de Sistemas"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center" />

</LinearLayout>