<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro_fondo"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Tarjeta de Detalle de Compra -->
        <LinearLayout
            android:id="@+id/cardDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/gris_tarjeta_detalle"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Encabezados de la tabla -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/EstiloEncabezadoTabla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/tabla_item" />

                <TextView
                    style="@style/EstiloEncabezadoTabla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="@string/tabla_producto" />

                <TextView
                    style="@style/EstiloEncabezadoTabla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:gravity="center"
                    android:text="@string/tabla_cantidad" />

                <TextView
                    style="@style/EstiloEncabezadoTabla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:gravity="end"
                    android:text="@string/tabla_total" />
            </LinearLayout>

            <!-- Lista de productos con límite de altura y barra de scroll -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetalleProductos"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:scrollbars="vertical"
                android:fadeScrollbars="false" />

            <!-- Subtotal General -->
            <TextView
                android:id="@+id/tvSubtotalDetalle"
                style="@style/EstiloSubtotalDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:text="@string/subtotal_ejemplo" />
        </LinearLayout>

        <!-- Botón HACER OTRA COMPRA -->
        <Button
            android:id="@+id/btnHacerOtraCompra"
            style="@style/EstiloBotonOtraCompra"
            android:layout_below="@id/cardDetalle"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:text="@string/btn_hacer_otra_compra" />

    </RelativeLayout>
</ScrollView>