<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    tools:context=".PantallaRelojes">

    <View
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/fondo_curvo"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Contenedor superior para la flecha y los títulos dinámicos -->
    <LinearLayout
        android:id="@+id/layoutBarraSuperior"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón o icono de retroceso -->
        <ImageView
            android:id="@+id/btnAtras"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/baseline_arrow_back_ios_24"
            android:contentDescription="@string/desc_volver"
            app:tint="@color/blanco" />

        <!-- Título principal -->
        <TextView
            style="@style/EstiloTituloMedianoHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_marginStart="16dp" />

        <TextView
            style="@style/EstiloTituloMedianoHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" | "
            android:layout_marginStart="8dp" />

        <!-- Título dinámico de la sección -->
        <TextView
            android:id="@+id/textoDos"
            style="@style/EstiloTituloMedianoHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_relojes"
            android:layout_marginStart="36dp" />
    </LinearLayout>

    <!-- RecyclerView para mostrar los productos filtrados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProductosPantalla"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/vista"
        app:layout_constraintBottom_toTopOf="@id/layaoutUno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Barra de navegación inferior -->
    <LinearLayout
        android:id="@+id/layaoutUno"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/blanco"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/botonInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/imagenUno"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/home"
                android:contentDescription="@string/menu_inicio" />
            <TextView
                android:id="@+id/Inicio"
                style="@style/EstiloTextoMenuInferior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_inicio" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/botonCarrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/imagenDOs"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/carrito"
                android:contentDescription="@string/menu_carrito" />
            <TextView
                android:id="@+id/Carrito"
                style="@style/EstiloTextoMenuInferior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_carrito" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/botonUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:id="@+id/imagenTres"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/usuario"
                android:contentDescription="@string/menu_usuario" />
            <TextView
                android:id="@+id/Usuario"
                style="@style/EstiloTextoMenuInferior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_usuario" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>