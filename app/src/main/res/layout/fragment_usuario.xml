<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- VISTA PARA USUARIO LOGUEADO (Contenedor general con ID) -->
        <LinearLayout
            android:id="@+id/layoutUsuarioLogueado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Tarjeta Superior: Foto y Nombre/Correo principal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/blanco"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/usuario"
                        app:tint="@color/negro" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNombrePerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Usuario"
                            android:textColor="@color/negro"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCorreoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="correo@casiostore.com"
                            android:textColor="#555555"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Datos personales"
                android:textColor="@color/blanco"
                android:textSize="14sp" />

            <!-- Tarjeta de Datos Personales -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardBackgroundColor="#D9D9D9"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Joel Roque"
                        android:textColor="@color/negro"
                        android:textSize="14sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#888888" android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Antinapa"
                        android:textColor="@color/negro"
                        android:textSize="14sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#888888" android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="13/02/2000"
                        android:textColor="@color/negro"
                        android:textSize="14sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#888888" android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/txtEmailDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="joel@casiostore.com"
                        android:textColor="@color/negro"
                        android:textSize="14sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#888888" android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+591 65854512"
                        android:textColor="@color/negro"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón Historial de Compras -->
            <Button
                android:id="@+id/btnIrHistorial"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1565C0"
                android:text="HISTORIAL DE COMPRAS"
                android:textColor="@color/blanco"
                android:textStyle="bold" />

            <!-- Botón Cerrar Sesión -->
            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1565C0"
                android:text="CERRAR SESIÓN"
                android:textColor="@color/blanco"
                android:textStyle="bold" />

            <!-- Botón Eliminar Cuenta -->
            <Button
                android:id="@+id/btnEliminarCuenta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#0D0033"
                android:text="ELIMINAR CUENTA"
                android:textColor="@color/blanco"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- VISTA PARA INVITADO (Oculta por defecto, se muestra solo si es invitado) -->
        <LinearLayout
            android:id="@+id/layoutInvitado"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="No has iniciado sesión"
                android:textColor="@color/blanco"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLoginDesdePerfil"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#d50000"
                android:text="INICIAR SESIÓN"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>