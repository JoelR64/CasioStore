<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- VISTA PARA USUARIO LOGUEADO -->
        <LinearLayout
            android:id="@+id/layoutUsuarioLogueado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Tarjeta Superior: Foto y Nombre/Correo principal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/blanco"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/usuario"
                        android:contentDescription="@string/desc_avatar_usuario"
                        app:tint="@color/negro" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNombrePerfil"
                            style="@style/EstiloNombrePerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/nombre_usuario_default" />

                        <TextView
                            android:id="@+id/txtCorreoPerfil"
                            style="@style/EstiloCorreoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/correo_usuario_default" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/EstiloSubtituloPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_datos_personales" />

            <!-- Tarjeta de Datos Personales -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardBackgroundColor="@color/gris_facturacion"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/EstiloItemDatoPersonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_nombre" />
                    <View style="@style/EstiloLineaDivisoria" />

                    <TextView
                        style="@style/EstiloItemDatoPersonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_apellido" />
                    <View style="@style/EstiloLineaDivisoria" />

                    <TextView
                        style="@style/EstiloItemDatoPersonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_nacimiento" />
                    <View style="@style/EstiloLineaDivisoria" />

                    <TextView
                        android:id="@+id/txtEmailDetalle"
                        style="@style/EstiloItemDatoPersonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_correo" />
                    <View style="@style/EstiloLineaDivisoria" />

                    <TextView
                        style="@style/EstiloItemDatoPersonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_telefono"
                        android:paddingBottom="0dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón Historial de Compras -->
            <Button
                android:id="@+id/btnIrHistorial"
                style="@style/EstiloBotonAzulPerfil"
                android:text="@string/btn_historial_compras" />

            <!-- Botón Cerrar Sesión -->
            <Button
                android:id="@+id/btnCerrarSesion"
                style="@style/EstiloBotonAzulPerfil"
                android:text="@string/btn_cerrar_sesion" />

            <!-- Botón Eliminar Cuenta -->
            <Button
                android:id="@+id/btnEliminarCuenta"
                style="@style/EstiloBotonEliminarPerfil"
                android:text="@string/btn_eliminar_cuenta" />
        </LinearLayout>

        <!-- VISTA PARA INVITADO -->
        <LinearLayout
            android:id="@+id/layoutInvitado"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="32dp">

            <TextView
                style="@style/EstiloTextoCarritoVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/mensaje_no_sesion"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnLoginDesdePerfil"
                style="@style/EstiloBotonAccionPerfil"
                android:backgroundTint="@color/rojo_principal"
                android:text="@string/btn_iniciar_sesion" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>