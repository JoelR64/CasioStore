<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    tools:context=".PagoFragment">

    <!-- TARJETA BLANCA PRINCIPAL -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/blanco"
        app:cardCornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SECCIÓN DE DATOS DE FACTURACIÓN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/gris_facturacion"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/EstiloTituloFacturacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:text="@string/titulo_datos_facturacion" />

                    <!-- NIT / CI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/EstiloLabelFacturacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_nit_ci" />

                        <EditText
                            android:id="@+id/etNitCi"
                            style="@style/EstiloInputFacturacion"
                            android:layout_width="match_parent"
                            android:inputType="number" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/gris_separador" />

                    <!-- RAZÓN SOCIAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/EstiloLabelFacturacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_razon_social" />

                        <EditText
                            android:id="@+id/etRazonSocial"
                            style="@style/EstiloInputFacturacion"
                            android:layout_width="match_parent"
                            android:inputType="textPersonName" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/gris_separador" />

                    <!-- TELÉFONO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/EstiloLabelFacturacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_telefono" />

                        <EditText
                            android:id="@+id/etTelefono"
                            style="@style/EstiloInputFacturacion"
                            android:layout_width="match_parent"
                            android:inputType="phone" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gris_separador" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ENCABEZADOS DE LA TABLA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:weightSum="4">

                <TextView
                    style="@style/EstiloEncabezadoTabla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="@string/tabla_producto" />

                <TextView
                    style="@style/EstiloEncabezadoTabla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:gravity="center"
                    android:text="@string/tabla_precio" />

                <TextView
                    style="@style/EstiloEncabezadoTabla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:gravity="center"
                    android:text="@string/tabla_cantidad" />

                <TextView
                    style="@style/EstiloEncabezadoTabla"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/tabla_subtotal" />
            </LinearLayout>

            <!-- LISTA DINÁMICA DE PRODUCTOS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerResumenPago"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- BOTONES DE PAGO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQr"
                style="@style/EstiloBotonPago"
                android:text="@string/btn_pago_qr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTarjeta"
                style="@style/EstiloBotonPago"
                android:text="@string/btn_pago_tarjeta" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>