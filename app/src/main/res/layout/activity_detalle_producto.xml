<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabecera con botón de retroceso y título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btnDetalleAtras"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/baseline_arrow_back_ios_24"
                android:contentDescription="@string/desc_volver" />

            <TextView
                style="@style/EstiloTituloDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_detalle_producto"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- Imagen del producto -->
        <ImageView
            android:id="@+id/imgDetalleProducto"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerInside"
            android:background="@color/gris_fondo_imagen"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/desc_imagen_producto" />

        <!-- Nombre del producto -->
        <TextView
            android:id="@+id/txtDetalleNombre"
            style="@style/EstiloNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Producto"
            android:layout_marginBottom="10dp" />

        <!-- Precio del producto -->
        <TextView
            android:id="@+id/txtDetallePrecio"
            style="@style/EstiloPrecioProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:layout_marginBottom="15dp" />

        <!-- Título de Descripción -->
        <TextView
            style="@style/EstiloSubtituloSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_descripcion"
            android:layout_marginBottom="5dp" />

        <!-- Texto de la Descripción -->
        <TextView
            android:id="@+id/txtDetalleDescripcion"
            style="@style/EstiloCuerpoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/texto_placeholder_descripcion"
            android:layout_marginBottom="20dp" />

        <!-- Botón para Agregar al Carrito -->
        <Button
            android:id="@+id/btnAgregarCarrito"
            style="@style/EstiloBotonCarrito"
            android:text="@string/btn_agregar_carrito" />

    </LinearLayout>
</ScrollView>